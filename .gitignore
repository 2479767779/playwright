# 依赖
node_modules/

# 构建产物（electron-builder 输出）
release/
release_new/
dist/
# 打包时用的临时输出目录（换目录名是为了绕开沙箱删除限制，用完即弃）
release-*/

# 内置 Chromium（416MB，electron-builder 用 extraResources 打包，不入库）
pw-browsers/

# 浏览器用户数据（含登录会话/cookie，敏感，不入库）
pw-data-*/
edge-user-data*/

# 运行日志
logs/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# 开发模式(bat)下生成的临时脚本（server 复制到根目录的 temp_*.js）
temp_*.js

# 用户配置（含账号名/可能的密钥，敏感，不入库）
# 注意：aiConfig.js 是「种子模板」需入库，请保持其中 endpoint/apiKey/model 为空！
detectAccounts.json
aiConfig.local.js

# 第三方参考源码（另一个项目，不混入本仓库）
chrome评论插件第一版源码0730/
# 上面的目录后来改名成了「插件源码」，旧规则已失效，补上当前名字
插件源码/

# 留痕证据（含真实文章信息、评论截图与账号痕迹，私密，不入库）
留痕截图/

# 本地调试脚本与探针产物（截图/临时 exe，体积可达数百 MB）
.probe/
.tmp/

# 本机 AI 工具的状态目录（机器相关）
.agents/
.claude/

# Claude Code 本地配置（机器相关，不入库）
.claude/settings.local.json

# IDE / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db


{
  "name": "ai-comment-assistant",
  "version": "1.4.5",
  "description": "AI 自动评论助手",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "server": "node server.js",
    "test": "node tests/runner-registry.check.js && node tests/url-rules.check.js && node tests/csdn-layout.check.js",
    "dist": "electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.aicomment.assistant",
    "productName": "AI评论助手",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "runner-registry.js",
      "aiConfig.js",
      "aiComment.js",
      "logger.js",
      "pauser.js",
      "detect.js",
      "detect_netease.js",
      "detect_runner.js",
      "evidence.js",
      "pinglun_*.js",
      "public/**/*",
      "!pw-browsers/**/*",
      "!release/**/*",
      "!dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/patchright/**/*",
      "node_modules/patchright-core/**/*"
    ],
    "extraResources": [
      {
        "from": "pw-browsers/chromium-1228",
        "to": "chromium-1228",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI评论助手",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "installerLanguages": [
        "zh_CN"
      ]
    }
  },
  "keywords": [
    "ai",
    "comment",
    "automation"
  ],
  "author": "fengxiaoyang",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "patchright": "^1.61.0",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}
